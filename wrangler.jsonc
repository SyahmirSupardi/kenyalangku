{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kenyalangku",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "kenyalangku" }],
  "images": { "binding": "IMAGES" },
  // Keep the live domain and the workers.dev setting in the file. Without these,
  // every `wrangler deploy` from Cloudflare Builds removes www.kenyalangku.my.
  "workers_dev": false,
  "routes": [{ "pattern": "www.kenyalangku.my", "zone_name": "kenyalangku.my", "custom_domain": true }],
  // Genesis Roulette closed alpha: claims database and private build storage.
  "d1_databases": [
    {
      "binding": "ALPHA_DB",
      "database_name": "kenyalangku-alpha",
      "database_id": "d70e654d-fa4c-4395-80a7-61ca823a1466",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ALPHA_BUILDS", "bucket_name": "genesis-roulette-closed-alpha" }],
  "vars": {
    "ALPHA_CAP": "100",
    "ALPHA_EMAIL_FROM": "KenyalangKu <admin@kenyalangku.my>",
    "ALPHA_SITE_URL": "https://www.kenyalangku.my",
    "ALPHA_BUILD_ANDROID": "GenesisRoulette-0.2.1-tester.apk",
    "ALPHA_BUILD_WINDOWS": "GenesisRoulette-0.2.1-win64.zip",
    "ALPHA_LINK_HOURS": "6",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGKAPS3sZFnkJ5Kv"
  }
  ,
  // Settings for `wrangler preview` (the Cloudflare build on pull requests).
  // Previews point at the same claims database and bucket as production. Treat a
  // preview URL as private: do not claim, redeem or download from it.
  "previews": {
    "vars": {
      "ALPHA_CAP": "100",
      "ALPHA_EMAIL_FROM": "KenyalangKu <admin@kenyalangku.my>",
      "ALPHA_SITE_URL": "https://www.kenyalangku.my",
      "ALPHA_BUILD_ANDROID": "GenesisRoulette-0.2.1-tester.apk",
      "ALPHA_BUILD_WINDOWS": "GenesisRoulette-0.2.1-win64.zip",
      "ALPHA_LINK_HOURS": "6",
      "TURNSTILE_SITE_KEY": "0x4AAAAAAGKAPS3sZFnkJ5Kv"
    },
    "d1_databases": [{ "binding": "ALPHA_DB", "database_id": "d70e654d-fa4c-4395-80a7-61ca823a1466" }],
    "r2_buckets": [{ "binding": "ALPHA_BUILDS", "bucket_name": "genesis-roulette-closed-alpha" }],
    "images": { "binding": "IMAGES" }
  }
}
